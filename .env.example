# Copy to .env and fill in. NEVER commit .env
ANTHROPIC_API_KEY=sk-ant-your-key-here
CTFD_URL=http://YOUR-EC2-PUBLIC-IP        # or http://localhost:8000
CTFD_TOKEN=ctfd_token_of_the_ai_agent_user  # Settings > Access Tokens (logged in as ai-agent-1)
CTFD_ADMIN_TOKEN=ctfd_token_of_admin        # only used by seed_challenges.py
MODEL=claude-sonnet-5-5
MAX_STEPS=15
MAX_ATTEMPTS=10
MAX_SECONDS=300
ENABLE_PYTHON=0
