# Copy to .env (scripts/init-env.sh does this and fills in random secrets).

# ---- CTFd ---------------------------------------------------------------
CTFD_URL=http://localhost          # use http://localhost:8000 if CTFD_PORT=8000
CTFD_PORT=80                       # host port for docker compose
CTF_NAME=FGCU CTF Lab
CTFD_ADMIN_NAME=admin
CTFD_ADMIN_EMAIL=admin@example.com
CTFD_ADMIN_PASSWORD=               # generated if blank
AGENT_USER_NAME=ctf-agent
AGENT_USER_EMAIL=agent@example.com
AGENT_USER_PASSWORD=               # generated if blank
# CTFD_TOKEN and CTFD_ADMIN_TOKEN are written here by `ctf-agent bootstrap`.

# ---- docker compose secrets (filled in by scripts/init-env.sh) ---------------
DB_PASSWORD=
DB_ROOT_PASSWORD=
SECRET_KEY=

# ---- Amazon Bedrock -------------------------------------------------------
AWS_REGION=us-east-2
# Run `ctf-agent models` to list valid IDs for your region. Use the us.* or global.* form.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
MAX_TOKENS=4096
# TEMPERATURE=                     # leave unset unless your model supports it

# ---- Benchmark limits -------------------------------------------------------
MAX_TURNS=25                       # model calls per challenge
MAX_ATTEMPTS=5                     # flag submissions per challenge
CHALLENGE_TIMEOUT_SECONDS=600
PYTHON_TIMEOUT_SECONDS=30
PYTHON_SANDBOX=auto                # auto | docker | subprocess
